# Server
PORT=3000
NODE_ENV=development

# Database
DB_SERVER=localhost
DB_DATABASE=choir_app
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=change-this-to-a-64-character-random-string-for-production-use
JWT_REFRESH_SECRET=change-this-to-another-64-char-random-string-for-refresh
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=30d

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
MAX_FILE_SIZE_MB=10
